{
    "name": "@beyonda-labs/angular-components",
    "version": "1.1.0",
    "packageManager": "pnpm@10.34.5",
    "publishConfig": {
        "registry": "https://verdaccio.home.arpa/"
    },
    "scripts": {
        "build": "ng build",
        "build:quick": "pnpm run prebuild && ng build --configuration=development",
        "build:watch": "node scripts/build-watch.js",
        "check-style-guides": "node scripts/check-style-guides.js",
        "check-tokens": "node scripts/check-tokens.js",
        "check-translations": "node scripts/check-translations.js",
        "format": "prettier --write \"{src,style-guide}/**/*.{ts,html,css,json}\"",
        "format:check": "prettier --check \"{src,style-guide}/**/*.{ts,html,css,json}\"",
        "lint": "ng lint && pnpm run stylelint && pnpm run check-translations && pnpm run check-tokens && pnpm run check-style-guides",
        "lint:fix": "ng lint --fix",
        "merge-translations": "pnpm run check-translations && node scripts/merge-translations.js",
        "prebuild": "pnpm run merge-translations",
        "prepare": "husky",
        "sort-translations": "node scripts/sort-translations.js",
        "stylelint": "stylelint \"{src,style-guide}/**/*.css\"",
        "stylelint:fix": "stylelint \"{src,style-guide}/**/*.css\" --fix",
        "test": "jest",
        "test:ci": "jest --ci",
        "test:coverage": "jest --coverage",
        "test:report": "jest --coverage --coverageReporters=lcov --coverageReporters=html",
        "test:watch": "jest --watch",
        "update-translations": "pnpm run sort-translations && pnpm run merge-translations && node scripts/update-translations.js",
        "verify": "pnpm run lint && pnpm run format:check && pnpm run test:ci"
    },
    "peerDependencies": {
        "@angular/animations": "19.2.17",
        "@angular/common": "19.2.17",
        "@angular/core": "19.2.17",
        "@angular/forms": "19.2.17",
        "@angular/platform-browser": "19.2.17",
        "@angular/platform-browser-dynamic": "19.2.17",
        "@angular/router": "19.2.17",
        "@ngx-translate/core": "16.0.4",
        "@ngx-translate/http-loader": "16.0.1",
        "bootstrap": "5.3.8",
        "monaco-editor": "0.52.2",
        "ngx-bootstrap": "19.0.2",
        "ngx-extended-pdf-viewer": "28.1.0",
        "ngx-monaco-editor-v2": "19.0.2",
        "rxjs": "7.8.2",
        "zone.js": "0.15.1"
    },
    "dependencies": {
        "@fortawesome/angular-fontawesome": "1.0.0",
        "@fortawesome/fontawesome-svg-core": "6.7.1",
        "@fortawesome/free-brands-svg-icons": "6.7.1",
        "@fortawesome/free-regular-svg-icons": "6.7.1",
        "@fortawesome/free-solid-svg-icons": "6.7.1",
        "@interactjs/types": "1.10.27",
        "interactjs": "1.10.27",
        "ngx-toastr": "19.0.0",
        "tslib": "2.7.0",
        "uuid": "11.1.0"
    },
    "devDependencies": {
        "@angular-devkit/build-angular": "19.2.19",
        "@angular-eslint/builder": "19.8.1",
        "@angular-eslint/eslint-plugin": "19.8.1",
        "@angular-eslint/eslint-plugin-template": "19.8.1",
        "@angular-eslint/schematics": "19.8.1",
        "@angular-eslint/template-parser": "19.8.1",
        "@angular/cli": "19.2.19",
        "@angular/compiler-cli": "19.2.17",
        "@angular/localize": "19.2.17",
        "@eslint/js": "^10.0.1",
        "@stylistic/eslint-plugin-js": "^2.13.0",
        "@types/jest": "29.5.14",
        "@types/uuid": "10.0.0",
        "angular-eslint": "19.8.1",
        "eslint": "9.39.5",
        "eslint-plugin-simple-import-sort": "^12.1.1",
        "eslint-plugin-unicorn": "^56.0.1",
        "fs-extra": "11.3.3",
        "husky": "^9.1.7",
        "jest": "29.7.0",
        "jest-mock-extended": "^4.0.0",
        "jest-preset-angular": "14.6.2",
        "lint-staged": "^17.5.1",
        "ng-packagr": "19.2.2",
        "prettier": "3.3.3",
        "stylelint": "^17.15.0",
        "stylelint-config-standard": "^40.0.0",
        "stylelint-declaration-strict-value": "^1.12.1",
        "ts-node": "10.9.2",
        "typescript": "5.5.4",
        "typescript-eslint": "8.70.1"
    },
    "private": false,
    "sideEffects": [
        "**/*.css"
    ]
}
