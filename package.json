{
    "name": "@beyonda-labs/angular-components",
    "version": "1.2.0",
    "packageManager": "pnpm@10.34.5",
    "publishConfig": {
        "registry": "https://verdaccio.home.arpa/"
    },
    "scripts": {
        "build": "ng build",
        "build:quick": "pnpm run prebuild && ng build --configuration=development",
        "build:watch": "node scripts/build-watch.js",
        "check-dependencies": "bey-check-dependencies",
        "check-style-guides": "node scripts/check-style-guides.js",
        "check-tokens": "node scripts/check-tokens.js",
        "check-translations": "bey-check-translations",
        "config:check": "bey-config check",
        "config:diff": "bey-config diff",
        "config:sync": "bey-config sync",
        "format": "prettier --write \"{src,style-guide,testing}/**/*.{ts,html,css,json}\"",
        "format:check": "prettier --check \"{src,style-guide,testing}/**/*.{ts,html,css,json}\"",
        "lint": "ng lint && pnpm run typecheck && pnpm run stylelint && pnpm run check-translations && pnpm run check-dependencies && pnpm run --if-present lint:project",
        "lint:fix": "ng lint --fix",
        "lint:project": "pnpm run check-tokens && pnpm run check-style-guides",
        "merge-translations": "bey-check-translations && bey-merge-translations",
        "prebuild": "pnpm run merge-translations",
        "prepare": "husky",
        "sort-translations": "bey-sort-translations",
        "stylelint": "stylelint \"{src,style-guide}/**/*.css\"",
        "stylelint:fix": "stylelint \"{src,style-guide}/**/*.css\" --fix",
        "test": "jest",
        "test:ci": "jest --ci --coverage --coverageReporters=text-summary",
        "test:coverage": "jest --coverage",
        "test:report": "jest --coverage --coverageReporters=lcov --coverageReporters=html",
        "test:watch": "jest --watch",
        "typecheck": "tsc -p tsconfig.spec.json --noEmit",
        "update-translations": "pnpm run sort-translations && pnpm run merge-translations && node scripts/update-translations.js",
        "verify": "pnpm run lint && pnpm run format:check && pnpm run test:ci && bey-config check"
    },
    "peerDependencies": {
        "@angular/animations": "19.2.17",
        "@angular/common": "19.2.17",
        "@angular/core": "19.2.17",
        "@angular/forms": "19.2.17",
        "@angular/platform-browser": "19.2.17",
        "@angular/platform-browser-dynamic": "19.2.17",
        "@angular/router": "19.2.17",
        "@ngx-translate/core": "16.0.4",
        "@ngx-translate/http-loader": "16.0.1",
        "bootstrap": "5.3.8",
        "monaco-editor": "0.52.2",
        "ngx-bootstrap": "19.0.2",
        "ngx-extended-pdf-viewer": "28.1.0",
        "ngx-monaco-editor-v2": "19.0.2",
        "rxjs": "7.8.2",
        "zone.js": "0.15.1"
    },
    "dependencies": {
        "@fortawesome/angular-fontawesome": "1.0.0",
        "@fortawesome/fontawesome-svg-core": "6.7.1",
        "@fortawesome/free-brands-svg-icons": "6.7.1",
        "@fortawesome/free-regular-svg-icons": "6.7.1",
        "@fortawesome/free-solid-svg-icons": "6.7.1",
        "@interactjs/types": "1.10.27",
        "interactjs": "1.10.27",
        "ngx-toastr": "19.0.0",
        "tslib": "2.7.0",
        "uuid": "11.1.0"
    },
    "devDependencies": {
        "@angular-devkit/build-angular": "19.2.19",
        "@angular-eslint/builder": "19.8.1",
        "@angular-eslint/schematics": "19.8.1",
        "@angular/cli": "19.2.19",
        "@angular/compiler-cli": "19.2.17",
        "@angular/localize": "19.2.17",
        "@beyonda-labs/base-config": "0.1.0-develop.1.d40cd19",
        "@types/jest": "29.5.14",
        "@types/uuid": "10.0.0",
        "eslint": "9.39.5",
        "fs-extra": "11.3.3",
        "husky": "9.1.7",
        "jest": "29.7.0",
        "jest-mock-extended": "4.0.1",
        "jest-preset-angular": "14.6.2",
        "lint-staged": "17.5.1",
        "ng-packagr": "19.2.2",
        "prettier": "3.3.3",
        "stylelint": "17.15.0",
        "ts-node": "10.9.2",
        "typescript": "5.5.4"
    },
    "private": false,
    "sideEffects": [
        "**/*.css"
    ]
}
