{
    "extends": ["stylelint-config-standard"],
    "plugins": ["stylelint-declaration-strict-value"],
    "ignoreFiles": ["dist/**/*", "node_modules/**/*"],
    "rules": {
        "declaration-no-important": true,
        "selector-class-pattern": [
            "^(bey-[a-z0-9]+(-[a-z0-9]+)*(--[a-z0-9]+(-[a-z0-9]+)*)?|(is|has)-[a-z0-9]+(-[a-z0-9]+)*|dark)$",
            {
                "message": "A class is bey-<module>-<part>, bey-<module>--<variant>, or an is-*/has-* state. To style a third-party class, disable this rule on the line with a reason."
            }
        ],
        "custom-property-pattern": [
            "^bey-[a-z0-9]+(-[a-z0-9]+)*$",
            {
                "message": "Custom properties are namespaced: --bey-*"
            }
        ],
        "scale-unlimited/declaration-strict-value": [
            [
                "/color$/",
                "background",
                "background-color",
                "border-color",
                "box-shadow",
                "fill",
                "font-size",
                "font-weight",
                "line-height",
                "stroke",
                "/^border(-(top|right|bottom|left))?$/",
                "border-radius",
                "gap",
                "column-gap",
                "row-gap",
                "opacity",
                "z-index",
                "transition-duration"
            ],
            {
                "ignoreValues": [
                    "0",
                    "1",
                    "auto",
                    "currentColor",
                    "currentcolor",
                    "dashed",
                    "dotted",
                    "double",
                    "ease",
                    "ease-in",
                    "ease-in-out",
                    "ease-out",
                    "hidden",
                    "inherit",
                    "initial",
                    "linear",
                    "none",
                    "normal",
                    "solid",
                    "transparent",
                    "unset"
                ],
                "ignoreKeywords": ["currentColor", "inherit", "transparent"],
                "severity": "warning",
                "message": "Use a --bey-* token instead of a literal value (see docs/tokens.md)"
            }
        ],
        "declaration-property-value-disallowed-list": [
            {
                "/.*/": ["/var\\(\\s*--bs-/"]
            },
            {
                "message": "A --bs-* variable is only ever assigned, never read (see rules/angular/styles.md)"
            }
        ],
        "no-descending-specificity": null,
        "comment-empty-line-before": null,
        "custom-property-empty-line-before": null,
        "declaration-empty-line-before": null,
        "rule-empty-line-before": null,
        "selector-not-notation": null,
        "media-feature-range-notation": null,
        "alpha-value-notation": null,
        "color-function-notation": null,
        "value-keyword-case": null,
        "selector-pseudo-element-no-unknown": [
            true,
            {
                "ignorePseudoElements": ["ng-deep"]
            }
        ],
        "color-function-alias-notation": null,
        "property-no-vendor-prefix": null,
        "import-notation": null,
        "selector-id-pattern": null
    },
    "overrides": [
        {
            "files": ["src/lib/assets/styles/**/*.css"],
            "rules": {
                "scale-unlimited/declaration-strict-value": null,
                "declaration-property-value-disallowed-list": null,
                "selector-class-pattern": null,
                "custom-property-pattern": null
            }
        },
        {
            "files": ["**/docs/style-guide/**/*.css"],
            "rules": {
                "selector-class-pattern": null,
                "scale-unlimited/declaration-strict-value": null
            }
        }
    ]
}
