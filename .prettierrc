{
    "arrowParens": "avoid",
    "bracketSpacing": true,
    "endOfLine": "lf",
    "htmlWhitespaceSensitivity": "ignore",
    "printWidth": 120,
    "semi": true,
    "singleQuote": true,
    "tabWidth": 4,
    "trailingComma": "none",
    "useTabs": false,
    "plugins": ["prettier-plugin-organize-attributes"],
    "attributeGroups": [
        "$ANGULAR_STRUCTURAL_DIRECTIVE",
        "$ANGULAR_ELEMENT_REF",
        "$ID",
        "$CLASS",
        "$DEFAULT",
        "$ANGULAR_INPUT",
        "$ANGULAR_TWO_WAY_BINDING",
        "$ANGULAR_OUTPUT"
    ],
    "attributeSort": "ASC",
    "overrides": [
        {
            "files": "*.html",
            "options": {
                "parser": "angular"
            }
        }
    ]
}
