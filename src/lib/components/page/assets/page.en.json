{
    "angular-components": {
        "http": {
            "error": {
                "sharing": {
                    "invalid-grantees": "Some of the users or groups chosen cannot get access to this folder: they belong to another organization, own it or no longer exist. Reload the page and try again."
                }
            },
            "title": {
                "sharing": {
                    "invalid-grantees": "Recipients not valid"
                }
            }
        },
        "page": {
            "actions": {
                "view": {
                    "label": "View",
                    "tooltip": "See the selected item without changing it"
                }
            },
            "count": {
                "categories": {
                    "one": "{{count}} folder",
                    "other": "{{count}} folders"
                },
                "items": {
                    "one": "{{count}} item",
                    "other": "{{count}} items"
                },
                "items-only": "({{items}})",
                "mixed": "({{categories}} · {{items}})"
            },
            "form": {
                "cancel": "Cancel",
                "submit": "Save"
            },
            "search": {
                "fields": {
                    "from": "From",
                    "organization-id": "Organization",
                    "owner-id": "Owner",
                    "to": "To"
                }
            },
            "share": {
                "access": {
                    "read": "View",
                    "write": "Edit"
                },
                "grantee": {
                    "group": "{{name}} (group)",
                    "members": {
                        "one": "{{name}} ({{count}} member)",
                        "other": "{{name}} ({{count}} members)"
                    }
                },
                "grantees": {
                    "no-match": "No user or group matches.",
                    "read": {
                        "empty": "Nobody added yet.",
                        "label": "Can view",
                        "placeholder": "Add a user or a group"
                    },
                    "write": {
                        "empty": "Nobody added yet.",
                        "label": "Can edit",
                        "placeholder": "Add a user or a group"
                    }
                },
                "inherited": {
                    "group": "{{name}} (group): {{access}}, from {{folder}}",
                    "label": "Access inherited from the folders above",
                    "user": "{{name}}: {{access}}, from {{folder}}"
                },
                "intro": "Sharing decides where people can work. What they can do there still depends on their permissions.",
                "title": "Share \"{{name}}\""
            },
            "shared": {
                "folder": "Shared folder",
                "label": "Shared with me"
            },
            "table": {
                "columns": {
                    "organization-name": "Organization",
                    "owner-name": "Owner"
                },
                "tooltips": {
                    "organization-name": "The organization it belongs to",
                    "owner-name": "The user it belongs to"
                }
            },
            "toast": {
                "restored-renamed": "Restored with a new name, since another item already has the old one: {{names}}"
            }
        }
    }
